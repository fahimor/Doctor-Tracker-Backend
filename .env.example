# Copy to .env for local development:  cp .env.example .env
# On Cloud Run, set these as environment variables / Secret Manager secrets instead.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker
# Optional: overrides the database name in the URI
# MONGODB_DB_NAME=doctor-tracker
# Optional: only if connecting to Atlas fails locally with "querySrv ECONNREFUSED"
# (your machine's DNS resolver refuses SRV lookups). Not needed on Cloud Run.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session length in seconds (default 12 hours)
JWT_TTL_SECONDS=43200

# Comma separated list of browser origins allowed to call the API directly.
# Example for production: https://doctor-tracker.vercel.app
CORS_ORIGINS=http://localhost:3000

# Session cookie. "lax" is correct when the frontend proxies /api (default setup).
COOKIE_NAME=dt_session
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=false

# Number of reverse proxies in front of the app (Cloud Run = 1)
TRUST_PROXY=1

# Optional: creates this admin on startup if it does not exist yet.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=a-strong-password
# BOOTSTRAP_ADMIN_NAME=Administrator
